{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "latest-debs",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-14",

  // Required for *.workers.dev deployments specifically: without this,
  // every outbound fetch() from the Worker (both the origin pass-through
  // and the manifest lookup) fails with Cloudflare error 1042 - workers.dev
  // is treated as one shared zone, and fetch() is restricted by default
  // for anything hosted there. Confirmed by deploying without it first.
  "compatibility_flags": ["global_fetch_strictly_public"],

  // Deploys to the account's free <name>.<subdomain>.workers.dev URL by
  // default - no custom domain or account budget required (see
  // PLATFORM-EVALUATION.md, "Decision", step 4). Point apt's sources.list
  // base URI at that URL once deployed; add a "routes"/"custom_domains"
  // entry here only if a real domain is later attached.
  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  // External liveness watchdog (scheduled() in src/worker.js). Every other
  // alarm this project has runs inside the same GitHub org as the thing it
  // watches, so they all go dark together; this one runs on Cloudflare's
  // cron, on a different account and platform, and checks the published
  // archive the way apt does. Every 6h, offset from the ~6h rebuild so it
  // never samples mid-publish. Needs ALERT_TOKEN to file its findings:
  //   wrangler secret put ALERT_TOKEN   # fine-grained PAT, apt-repo only,
  //                                     # Issues: read+write
  // Without the secret it still runs and logs; it just cannot open the
  // origin-unhealthy issue.
  "triggers": {
    "crons": ["17 */6 * * *"]
  },

  // Usage analytics. This Worker is the only point in the stack that sees a
  // real apt request, so it is the only place a per-suite/per-arch breakdown
  // can come from - GitHub's release-asset counter sees the 302 target and
  // nothing else. Free plan: 100,000 data points written and 10,000 read
  // queries per day, and Cloudflare does not bill for Analytics Engine at
  // all today - so this stays inside PLATFORM-EVALUATION.md's zero-cost
  // constraint. Query via the SQL API; see README.md, "Usage analytics".
  // Analytics Engine must be switched on for the account before this
  // binding will deploy (dash.cloudflare.com -> Workers -> Analytics
  // Engine); with it off, the whole deploy fails on API error 10089.
  // src/worker.js no-ops when env.AE is absent, so dropping this block is
  // always a safe way to ship an urgent fix.
  "analytics_engine_datasets": [
    {
      "binding": "AE",
      "dataset": "latest_debs_requests"
    }
  ],

  // ORIGIN_BASE: everything except /pool/* is proxied here unchanged.
  // MANIFEST_URL: pkg -> {repo, tag} map, written by scripts/build-repo.sh.
  // Both point at the current production origin during the transition
  // window described in step 4 - update only once apt-repo's own base URI
  // moves (it shouldn't need to, since this Worker *becomes* the base URI
  // apt clients use; ORIGIN_BASE stays pinned to GitHub Pages as the
  // backing index store either way).
  "vars": {
    "ORIGIN_BASE": "https://latest-debs.github.io/apt-repo/",
    "MANIFEST_URL": "https://latest-debs.github.io/apt-repo/dists/pkg-repo-map.json",
    // PUBLIC_BASE: this Worker's own public URL. The watchdog fetches it to
    // check the redirect path end to end, which ORIGIN_BASE alone cannot
    // cover - the "//dists/..." 404 lived entirely in this hop.
    "PUBLIC_BASE": "https://latest-debs.ranjithraj.workers.dev"
  }
}
